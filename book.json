{
  "root": "./docs",
  "title": "Mentat — Discord Bot for Dune: Awakening",
  "description": "Complete documentation for Mentat (Sahir Venn), the Discord bot that connects your Dune: Awakening server to Discord.",
  "author": "Project Arrakis",
  "language": "en",
  "gitbook": ">=3.0.0",
  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  },
  "links": {
    "sidebar": {
      "GitHub Repository": "https://github.com/Project-Arrakis/mentat",
      "Discord Server": "https://discord.gg/your-discord",
      "Report an Issue": "https://github.com/Project-Arrakis/mentat/issues",
      "Contributing": "https://github.com/Project-Arrakis/mentat/blob/main/CONTRIBUTING.md"
    }
  },
  "plugins": [
    "search",
    "prism",
    "-lunr",
    "github",
    "scripts"
  ],
  "pluginsConfig": {
    "github": {
      "url": "https://github.com/Project-Arrakis/mentat"
    },
    "scripts": {
      "files": ["./_ga.js"]
    }
  }
}
