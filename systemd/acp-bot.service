[Unit]
Description=Arrakis Control Panel — Discord Bot
After=network.target docker.service cloudflared.service
Requires=docker.service

[Service]
Type=simple
User=dune
WorkingDirectory=/home/dune/arrakis-control-panel
EnvironmentFile=/home/dune/arrakis-control-panel/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=10
StandardOutput=append:/home/dune/arrakis-control-panel/logs/bot.log
StandardError=append:/home/dune/arrakis-control-panel/logs/bot.log

# Capabilities & Privileges
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem Isolation
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dune/arrakis-control-panel/data /home/dune/arrakis-control-panel/logs /tmp
ReadOnlyPaths=/home/dune/arrakis-control-panel
PrivateTmp=yes
PrivateDevices=yes
UMask=0077

# User Namespace (test carefully — may interact with bind mounts)
# PrivateUsers=yes

# Kernel & System Isolation
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes

# /proc Hardening (requires systemd >= 256)
ProtectProc=invisible
ProcSubset=pid

# Execution Restrictions
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Network
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Tier 1: deny special-use / lateral-movement ranges
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=169.254.0.0/16
IPAddressDeny=224.0.0.0/4
IPAddressDeny=240.0.0.0/4
IPAddressDeny=0.0.0.0/8
IPAddressDeny=::1/128
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
IPAddressAllow=192.168.20.0/24

# System Call Filtering
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# IPC Cleanup
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
