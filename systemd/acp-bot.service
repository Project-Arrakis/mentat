# Canonical systemd unit template for the ACP Discord bot's deploy
# target. Corrected 2026-08-17 (issue #174): User/paths now match the
# real, live unit on the dedicated bot VM (VMID 103, "acp-bot",
# 192.168.22.10, Services VLAN 22, user `bot`) -- confirmed via
# `systemctl cat acp-bot.service` on that host. Previously said
# `User=ubuntu` (the old OCI VPS's user), which had already drifted from
# the live unit on the new VM before this file was ever updated for the
# migration. IPAddressAllow includes both 192.168.20.0/24 (dune-prod)
# and 192.168.21.0/24 (dune-dev) since this bot is multi-tenant and
# reaches both game-server consoles' adapter APIs.
[Unit]
Description=Arrakis Control Panel — Discord Bot
After=network.target

[Service]
Type=simple
User=bot
WorkingDirectory=/home/bot/arrakis-control-panel
EnvironmentFile=/home/bot/arrakis-control-panel/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=10
StandardOutput=append:/home/bot/arrakis-control-panel/logs/bot.log
StandardError=append:/home/bot/arrakis-control-panel/logs/bot.log

# Capabilities & Privileges
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem Isolation
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/bot/arrakis-control-panel/data /home/bot/arrakis-control-panel/logs /tmp
ReadOnlyPaths=/home/bot/arrakis-control-panel
PrivateTmp=yes
PrivateDevices=yes
UMask=0077

# Kernel & System Isolation
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes

# Execution Restrictions
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Network
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=169.254.0.0/16
IPAddressDeny=224.0.0.0/4
IPAddressDeny=240.0.0.0/4
IPAddressDeny=0.0.0.0/8
IPAddressDeny=::1/128
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
IPAddressAllow=192.168.20.0/24
IPAddressAllow=192.168.21.0/24

# System Call Filtering
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# IPC Cleanup
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
