[Unit]
Description=Arrakis Control Panel — Discord Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/arrakis-control-panel
EnvironmentFile=/home/ubuntu/arrakis-control-panel/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/arrakis-control-panel/logs/bot.log
StandardError=append:/home/ubuntu/arrakis-control-panel/logs/bot.log

# Capabilities & Privileges
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem Isolation
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/arrakis-control-panel/data /home/ubuntu/arrakis-control-panel/logs /tmp
ReadOnlyPaths=/home/ubuntu/arrakis-control-panel
PrivateTmp=yes
PrivateDevices=yes
UMask=0077

# Kernel & System Isolation
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes

# Execution Restrictions
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Network
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=169.254.0.0/16
IPAddressDeny=224.0.0.0/4
IPAddressDeny=240.0.0.0/4
IPAddressDeny=0.0.0.0/8
IPAddressDeny=::1/128
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
IPAddressAllow=192.168.20.0/24

# System Call Filtering
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# IPC Cleanup
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
