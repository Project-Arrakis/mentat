# ============================================================
# Arrakis Control Panel — Discord Bot Configuration
# ============================================================
#
# This file contains all the settings for the Discord bot.
# Lines starting with # are comments — they explain what each
# setting does. Uncomment a line (remove the #) and fill in
# your value to use it.
#
# NEED HELP? See the Admin Guide: docs/admin-guide.md
#

# ============================================================
# REQUIRED — These 4 settings MUST be filled in for the bot to work
# ============================================================

# Your Discord bot token. This is like a password that lets the bot
# connect to your Discord server. Get it from:
#   Discord Developer Portal → Your Application → Bot → Reset Token → Copy
DISCORD_BOT_TOKEN=replace-with-discord-bot-token

# Your Discord application ID. This is a number that identifies your bot.
# Get it from:
#   Discord Developer Portal → Your Application → General Information → Application ID
DISCORD_CLIENT_ID=replace-with-discord-application-client-id

# The web address of your Dune game server's console. This is how the bot
# talks to your game server. Usually it's http:// followed by your server's
# IP address and port 3000 or 8088.
# Examples: http://192.168.1.100:3000 or http://localhost:8088
DUNE_CONSOLE_API_URL=http://console-api:3000

# A secret token that both the bot and the game server console know.
# This proves the bot is allowed to talk to the console. Create a random
# string (at least 32 characters) and use the SAME value on both sides:
#   - Here in the bot config
#   - In the console's bot-api-token.txt file
DUNE_DISCORD_ADAPTER_TOKEN=replace-with-console-adapter-token

# ============================================================
# ROLE-BASED ACCESS — Who can use which commands
# ============================================================
#
# The bot uses Discord roles to control who can do what. Think of roles
# like badges — if you have the right badge, you can use certain commands.
#
# To find a role ID:
#   1. In Discord, go to User Settings → Advanced → turn ON "Developer Mode"
#   2. Go to Server Settings → Roles
#   3. Right-click a role → Copy Role ID
#
# RBAC_MODE can be:
#   restricted (default) — Only people with assigned roles can use commands
#   open — Anyone in the server can use read-only commands
DISCORD_RBAC_MODE=restricted

# Role IDs for people who can use read-only commands (status, population, etc.)
# Separate multiple IDs with commas: 123456,789012,345678
DISCORD_OBSERVER_ROLE_IDS=replace-with-discord-observer-role-id

# Role IDs for people who can use admin commands (doctor, diagnostics, etc.)
DISCORD_ADMIN_ROLE_IDS=

# Role IDs for people who can use write commands (broadcast, etc.)
# These are disabled by default for safety. See DUNE_DISCORD_WRITES_ENABLED below.
DISCORD_WRITE_ADMIN_ROLE_IDS=

# Role IDs for people who can use high-risk write commands (player moderation, etc.)
# These are not yet available. Reserved for future releases.
DISCORD_WRITE_OWNER_ROLE_IDS=

# Specific Discord user IDs who can use ALL commands, regardless of roles.
# Useful for the server owner. Separate multiple IDs with commas.
DISCORD_ALLOWED_USER_IDS=

# ============================================================
# PER-COMMAND ROLE OVERRIDES (Optional)
# ============================================================
#
# By default, all read-only commands use DISCORD_OBSERVER_ROLE_IDS
# and all admin commands use DISCORD_ADMIN_ROLE_IDS. You can override
# this for individual commands if you want finer control.
#
# If left blank, the command uses the default observer/admin roles.

# Who can use /dune core about
DISCORD_ABOUT_ROLE_IDS=

# Who can use /dune core ping
DISCORD_PING_ROLE_IDS=

# Who can use /dune server health
DISCORD_HEALTH_ROLE_IDS=

# Who can use /dune server status
DISCORD_STATUS_ROLE_IDS=

# Who can use /dune server summary (compact text version)
DISCORD_STATUS_SUMMARY_ROLE_IDS=

# Who can use /dune server readiness
DISCORD_READINESS_ROLE_IDS=

# Who can use /dune server services
DISCORD_SERVICES_ROLE_IDS=

# Who can use /dune data population
DISCORD_POPULATION_ROLE_IDS=

# Who can use /dune data backups
DISCORD_BACKUPS_ROLE_IDS=

# Legacy setting — prefer DISCORD_OBSERVER_ROLE_IDS for new setups
DISCORD_ALLOWED_ROLE_IDS=

# ============================================================
# PLAYER FEATURES — Character linking and inventory
# ============================================================
#
# These settings control the player inventory and storage features.
# Players must first link their Discord account to their in-game
# character before they can check their inventory or storage.
#
# No additional configuration is needed — these features work
# automatically once the bot is connected to the game server.

# ============================================================
# DISCORD SETTINGS
# ============================================================

# Set this while testing so slash command updates appear quickly
# in one specific Discord server. Leave blank for production.
# To find your server ID: Enable Developer Mode in Discord, then
# right-click your server icon → Copy Server ID
DISCORD_GUILD_ID=

# When true, bot replies are only visible to the person who ran the
# command. When false, everyone in the channel can see the reply.
# true = private replies (recommended)
# false = public replies (useful for status channels)
DISCORD_DEFAULT_EPHEMERAL=true

# How long to wait (in milliseconds) before giving up on a request
# to the game server. 8000 = 8 seconds.
REQUEST_TIMEOUT_MS=8000

# ============================================================
# ADAPTER ROUTE OVERRIDES (Advanced)
# ============================================================
#
# These settings let you change the web addresses the bot uses
# to talk to the game server console. You should NOT need to
# change these unless you have a custom console setup.

# Health check address
DUNE_ADAPTER_HEALTH_PATH=/api/integrations/discord/health

# Server status address
DUNE_ADAPTER_STATUS_PATH=/api/integrations/discord/status

# Server readiness address
DUNE_ADAPTER_READINESS_PATH=/api/integrations/discord/readiness

# Server services address
DUNE_ADAPTER_SERVICES_PATH=/api/integrations/discord/services

# Server population address
DUNE_ADAPTER_POPULATION_PATH=/api/integrations/discord/population

# Backup list address
DUNE_ADAPTER_BACKUPS_PATH=/api/integrations/discord/backups/list

# Announcements address
DUNE_ADAPTER_ANNOUNCEMENTS_PATH=/api/integrations/discord/announcements

# Broadcast address
DUNE_ADAPTER_BROADCAST_PATH=/api/integrations/discord/broadcast

# How the bot asks for health info (GET or POST)
DUNE_ADAPTER_HEALTH_METHOD=GET

# How the bot asks for status info (GET or POST)
DUNE_ADAPTER_STATUS_METHOD=POST

# How the bot asks for readiness info (GET or POST)
DUNE_ADAPTER_READINESS_METHOD=POST

# How the bot asks for services info (GET or POST)
DUNE_ADAPTER_SERVICES_METHOD=POST

# ============================================================
# SCHEDULED STATUS POSTS
# ============================================================
#
# The bot can automatically post server status to a Discord channel
# at regular intervals. This is useful for keeping everyone informed
# without them having to run commands.

# What kind of status to post automatically:
#   none = Disabled (default)
#   status = Full status data
#   status-summary = Compact summary (recommended for most servers)
#   readiness = Readiness checks
#   services = Service container list
DUNE_POST_SCHEDULE_TYPE=none

# Which Discord channel(s) to post status updates to.
# To find a channel ID: Enable Developer Mode, right-click the channel → Copy Channel ID
# Separate multiple channel IDs with commas.
DUNE_POST_ALLOWED_CHANNELS=

# How often to post status updates, in milliseconds.
# 1800000 = 30 minutes (recommended)
# 600000 = 10 minutes
# 3600000 = 1 hour
DUNE_SCHEDULER_INTERVAL_MS=1800000

# Minimum time between posts to the same channel, in milliseconds.
# This prevents the bot from posting too frequently.
# 600000 = 10 minutes (default)
DUNE_POST_RATE_LIMIT_MS=600000

# ============================================================
# IN-GAME ANNOUNCEMENTS
# ============================================================
#
# The bot can forward announcements from the game server to a
# Discord channel. For example, when a server event happens,
# the bot will post about it in Discord.

# Set to true to enable forwarding game announcements to Discord
DUNE_ANNOUNCEMENTS_ENABLED=false

# Which Discord channel to post announcements to.
# To find a channel ID: Enable Developer Mode, right-click the channel → Copy Channel ID
DUNE_ANNOUNCEMENTS_CHANNEL=

# How often to check for new announcements, in milliseconds.
# 30000 = 30 seconds (default)
DUNE_ANNOUNCEMENTS_POLL_MS=30000

# ============================================================
# WRITE COMMANDS (Advanced — Disabled by Default)
# ============================================================
#
# Write commands let the bot send messages to all in-game players
# (broadcast). These are disabled by default for safety.
#
# ⚠️ Only enable these if you understand the risks and have
# tested thoroughly.

# Master switch for all write-capable commands.
# true = Enable write commands
# false = Disable write commands (default, recommended)
DUNE_DISCORD_WRITES_ENABLED=false

# ============================================================
# COOLDOWNS
# ============================================================
#
# Cooldowns prevent people from spamming commands.

# How long a regular user must wait between commands, in milliseconds.
# 5000 = 5 seconds (default)
DUNE_COOLDOWN_MS=5000

# How long an admin must wait between commands, in milliseconds.
# Admins get a shorter cooldown because they use commands more often.
# 1000 = 1 second (default)
DUNE_ADMIN_COOLDOWN_MS=1000

# ============================================================
# HEALTH CHECK
# ============================================================
#
# These settings control how Docker checks if the bot is healthy.

# Where the bot writes its health status file.
# Docker reads this file to check if the bot is still running.
DUNE_BOT_HEALTH_STATE_FILE=/tmp/dune-discord-bot/health.json

# How old the health file can be before Docker considers the bot unhealthy.
# 120000 = 2 minutes (default)
DUNE_BOT_HEALTH_MAX_AGE_MS=120000

# ============================================================
# FILE-BASED SECRETS (Recommended for Production)
# ============================================================
#
# Instead of putting tokens directly in this file, you can store
# them in separate files. This is more secure because:
#   - Tokens don't appear in command history
#   - Files can have restricted permissions (only readable by the bot)
#   - Easier to rotate tokens without editing this file
#
# To use file-based secrets:
#   1. Create a file with your token: echo -n "your-token" > /path/to/token.txt
#   2. Set permissions: chmod 600 /path/to/token.txt
#   3. Point the bot to the file using the settings below
#
# When both a direct token and a file path are set, the direct token wins.

# Path to a file containing your Discord bot token
# DISCORD_BOT_TOKEN_FILE=/app/secrets/discord-bot-token.txt

# Path to a file containing your adapter token
# DUNE_DISCORD_ADAPTER_TOKEN_FILE=/app/secrets/adapter-token.txt

# ============================================================
# MULTI-TENANT MODE (Optional — for hosted deployments)
# ============================================================
#
# When enabled, the bot serves multiple Discord servers, each
# connected to its own Dune console. Configuration is stored
# in a local SQLite database and managed via a web portal.
#
# Set to true to enable multi-tenant mode.
# false = Single-server mode (default, uses DUNE_CONSOLE_API_URL)
# true = Multi-tenant mode (uses per-guild config from database)
ACP_MULTI_TENANT=false

# Path to the SQLite database file for multi-tenant config.
# Only used when ACP_MULTI_TENANT=true.
ACP_DB_PATH=data/acp.db

# Base URL for the setup web portal.
# Only used when ACP_MULTI_TENANT=true.
ACP_BASE_URL=http://localhost:3100

# Port for the setup web portal.
# Only used when ACP_MULTI_TENANT=true.
ACP_SETUP_PORT=3100

# OAuth2 redirect URI for Discord login.
# Only used when ACP_MULTI_TENANT=true.
# Example: http://localhost:3100/oauth/callback
ACP_OAUTH_REDIRECT_URI=

# Discord OAuth2 client secret (required for multi-tenant mode).
# Get it from: Discord Developer Portal → Your Application → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=

# Path to a file containing your Discord OAuth2 client secret.
# DISCORD_CLIENT_SECRET_FILE=/app/secrets/discord-client-secret.txt

# ============================================================
# LIVE STATS — Cloudflare KV (Optional)
# ============================================================
#
# The bot can push live stats (guild count, command count, uptime)
# to Cloudflare KV. A Cloudflare Pages Function reads these stats
# and serves them at /api/stats on your landing page.
#
# This requires:
#   1. A Cloudflare account (free tier works)
#   2. A KV namespace created via: wrangler kv:namespace create "ACP_STATS"
#   3. An API token with "KV Storage: Edit" permission
#
# See: docs/live-stats.md for setup instructions

# Your Cloudflare account ID (found in the URL of your Cloudflare dashboard)
CLOUDFLARE_ACCOUNT_ID=

# API token with KV Storage: Edit permission
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# KV namespace ID (from wrangler kv:namespace create output)
KV_NAMESPACE_ID=

# How often to push stats to KV, in milliseconds.
# 300000 = 5 minutes (recommended, stays within free tier limits)
# 60000 = 1 minute (more frequent, may exceed free tier write limits)
STATS_PUSH_INTERVAL_MS=300000

# Stable identifier for THIS bot process/deployment, used to build its
# per-instance KV key (acp-stats-{ACP_INSTANCE_ID}) and to correlate
# stats_pusher.instance / stats_push.error log lines back to a specific
# deployment. If unset, a fresh random UUID is generated on every
# process restart -- harmless for the shared acp-stats-aggregate key
# (every instance overwrites the same key), but means the per-instance
# key accumulates a new orphaned entry in KV on every restart, since the
# previous restart's key is never cleaned up. Set this to any stable,
# unique-per-deployment string (e.g. your server's hostname, or a fixed
# UUID you generate once) if you run more than one instance, or want to
# avoid that per-restart KV growth.
ACP_INSTANCE_ID=
